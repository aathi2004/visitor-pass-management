# ------------------------------------------------------------------
# Visitor Pass Management System - environment configuration
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# --- Backend (read at runtime by backend/src/config) ---
# MongoDB connection string. Local default, or a MongoDB Atlas string:
#   mongodb+srv://<user>:<password>@cluster0.abcd123.mongodb.net/visitor-pass
MONGODB_URI=mongodb://127.0.0.1:27017/visitor-pass

# Secret used to sign JWTs. Use a strong random value in production.
JWT_SECRET=visitor-pass-super-secret-key-change-me

# JWT lifetime (e.g. 1d, 8h).
JWT_EXPIRES_IN=8h

# Port for the local Express API server.
PORT=5000

# Comma-separated list of allowed CORS origins.
# In the combined app the frontend calls /api on the same origin, so this is
# only needed when you also access the API from other origins.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (read at build time; VITE_* vars are inlined into the bundle) ---
# Backend base URL used by the built app.
# Leave empty: requests go to the same origin (/api) - this is what the
# combined Vercel deployment uses.
# Set only if you want the built app to call an external API:
# VITE_API_URL=https://visitor-pass-backend.vercel.app
VITE_API_URL=

# --- SMTP / Email (optional, for notification emails) ---
# SMTP configuration for sending notification emails.
# If not configured, emails are skipped gracefully (only in-app notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@visitorpass.com
